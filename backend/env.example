# Database Configuration
# PostgreSQL database connection settings (required for mvn spring-boot:run / IDE — no default password)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=univoyage_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Docker Compose: both services load this file — required for `docker compose up`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
# Host port for Postgres (container still uses 5432). Default 5433 avoids Windows bind errors on 5432.
# POSTGRES_HOST_PORT=5433
# Optional overrides for Spring in the backend container (defaults fall back to POSTGRES_* above)
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_db_password
# SPRING_FLYWAY_USER=postgres
# SPRING_FLYWAY_PASSWORD=your_db_password

# JWT Configuration
# Secret key for JWT token signing (use a strong random string in production)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Weather API Configuration
# OpenWeather API key (get one at https://openweathermap.org/api)
# Required for weather features
OPENWEATHER_API_KEY=your-openweather-api-key

# Geoapify API Configuration
# Get your API key from https://myprojects.geoapify.com/
# Required for Points of Interest / Places features
GEOAPIFY_API_KEY=your-geoapify-api-key

# Google Gemini AI Configuration
# Get your API key from https://aistudio.google.com/apikey
# Required for AI features (itinerary generation, packing suggestions)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Amadeus Hotel API Configuration
# Get your credentials from https://developers.amadeus.com
# Required for hotel/accommodation features
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# Google OAuth Configuration
# Optional: Only needed if Google OAuth login is enabled
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Registered redirect URIs (comma-separated allowlist; must match Google Cloud Console). Uses GOOGLE_REDIRECT_URI if GOOGLE_REDIRECT_URIS is unset.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# GOOGLE_REDIRECT_URIS=https://your-app.example/auth/google/callback,http://localhost:5173/auth/google/callback

# Outbound email (OTP and future transactional mail)
# EMAIL_PROVIDER=logging | smtp | sendgrid | resend | postmark
# EMAIL_PROVIDER=logging
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_FROM_NAME=UniVoyage
# EMAIL_PRODUCT_NAME=UniVoyage
# EMAIL_REPLY_TO=support@your-domain.com
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# EMAIL_RETRY_MAX_ATTEMPTS=3
# EMAIL_TEST_CONNECTION=true

# SMTP (when EMAIL_PROVIDER=smtp)
# SPRING_MAIL_HOST=smtp.sendgrid.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=your-smtp-password-or-api-key
# SPRING_MAIL_SSL_TRUST=smtp.sendgrid.net

# Optional OAuth policy (defaults shown)
# OAUTH_REQUIRE_EMAIL_VERIFIED=true
# Require SPA to POST signed `state` + OIDC nonce on authorize (recommended once frontend supports it)
# OAUTH_REQUIRE_SIGNED_STATE=false
# Dedicated HMAC secret for signed OAuth state (defaults to JWT_SECRET if unset)
# OAUTH_STATE_SECRET=
# Currency apis
# Get credentials from https://app.exchangerate-api.com/dashboard
APP_CURRENCY_API_KEY=your-exchangerate-api-key
APP_CURRENCY_FALLBACK_KEY=your-exchangerate-fallback-api-key

# Production / staging: comma-separated frontend origins (HTTPS in production)
# CORS_ALLOWED_ORIGINS=https://your-app.example,https://www.your-app.example

# --- Logging (Docker Compose / profile=docker) ---
# See docs/logging-docker.md for paths, rotation, and verification steps.
# Backend uses Log4j2 (log4j2.xml); LOG_DIR is set to /app/logs in docker-compose.
# LOGGING_LEVEL_COM_UNIVOYAGE=DEBUG
# LOGGING_LEVEL_ROOT=INFO
# LOG_FILE_MAX_SIZE=10 MB
# LOG_ROLLING_MAX_FILES=14
#
# PostgreSQL server verbosity (maps to postgresql.conf-style settings)
# POSTGRES_LOG_MIN_MESSAGES=info
# POSTGRES_LOG_STATEMENT=none
