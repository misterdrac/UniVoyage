# API base URL (Vite injects at build time)
VITE_API_URL=http://localhost:8080/api

# --- Auth / OAuth (frontend) ---
# OAuth client secrets and redirect allowlists live in backend/env.example only.
# Browser routes (must match provider consoles + backend allowlist):
#   http://localhost:5173/auth/google/callback
#   http://localhost:5173/auth/github/callback
#   http://localhost:5173/auth/linkedin/callback
#
# Email deep links (backend builds URLs from APP_FRONTEND_*):
#   http://localhost:5173/auth/reset-password?token=...
#   http://localhost:5173/auth/verify-email?token=...
#
# Optional: open login for manual a11y audit
#   http://localhost:5173/?login=1
